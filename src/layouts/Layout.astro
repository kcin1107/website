---
import '../styles/global.css'
import githubIcon from '../assets/images/github-icon.svg'
import linkedinIcon from '../assets/images/linkedin-icon.svg'

interface Props {
  title: string
}

const { title } = Astro.props
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{title}</title>
  <link rel="icon" href="/assets/icons/favicon-150.png" sizes="32x32">
  <link rel="icon" href="/assets/icons/favicon-300.png" sizes="192x192">
  <link rel="apple-touch-icon" href="/assets/icons/favicon-300.png">
  <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="5543b25a-c01b-4682-b581-189a29d5bf87"></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Nick Ringelmann',
    url: 'https://nickringelmann.com',
    sameAs: ['https://www.linkedin.com/in/nick-ringelmann'],
  })} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify([
    {
      '@context': 'https://schema.org',
      '@type': 'SiteNavigationElement',
      name: 'Projects',
      url: 'https://nickringelmann.com/projects',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'SiteNavigationElement',
      name: 'Approach',
      url: 'https://nickringelmann.com/#approach',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'SiteNavigationElement',
      name: 'Blog',
      url: 'https://nickringelmann.com/blog',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'SiteNavigationElement',
      name: 'Clients',
      url: 'https://nickringelmann.com/#clients',
    },
  ])} />
  <script is:inline>
    (function () {
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
</head>
<body>

  <!-- Navigation -->
  <nav class="nav">
    <div class="nav__wrapper">
      <a class="nav__logo" href="/" aria-label="Nick Ringelmann – Product Designer">
        <span class="nav__logo-name"><span class="nav__logo-first"><span class="nav__logo-letter">N</span><span class="nav__logo-collapse">ick</span></span><span class="nav__logo-space"> </span><span class="nav__logo-last"><span class="nav__logo-letter">R</span><span class="nav__logo-collapse">ingelmann</span></span></span>
      </a>
      <div class="nav__links">
        <a class="primaryButton" href="/projects">Projects</a>
        <a class="primaryButton" href="/#approach">Approach</a>
        <a class="primaryButton" href="/blog">Blog</a>
        <a class="primaryButton" href="/#clients">Clients</a>
      </div>
      <div class="nav__actions">
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <svg class="icon-moon" width="1.1em" height="1.1em" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15.0298 2.48972C14.1569 2.21472 13.4108 3.16871 13.8735 3.95871C14.6045 5.20471 14.9985 6.61072 14.9985 8.02072C14.9985 12.4387 11.4168 16.0207 6.99848 16.0207C6.16658 16.0207 5.32518 15.8857 4.56098 15.6457C3.68808 15.3707 2.91068 16.3247 3.37348 17.1147C5.15098 20.1467 8.39968 22.0207 11.9985 22.0207C17.5213 22.0207 21.9985 17.5437 21.9985 12.0207C21.9985 7.61972 19.158 3.78772 15.0298 2.48972Z" fill="currentColor"/>
        </svg>
        <svg class="icon-sun" width="1.1em" height="1.1em" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12.0137 1.95312C11.4617 1.95312 11.0137 2.40113 11.0137 2.95313V4.95313C11.0137 5.50513 11.4617 5.95313 12.0137 5.95313C12.5657 5.95313 13.0137 5.50513 13.0137 4.95313V2.95313C13.0137 2.40113 12.5657 1.95312 12.0137 1.95312ZM5.63867 4.57813C5.38267 4.57813 5.14667 4.69513 4.95167 4.89113C4.56067 5.28113 4.56067 5.90712 4.95167 6.29712L6.29467 7.67212C6.68567 8.06212 7.34266 8.06312 7.73266 7.67212C8.12266 7.28112 8.12366 6.62413 7.73266 6.23413L6.35766 4.89113C6.16166 4.69513 5.89467 4.57813 5.63867 4.57813ZM18.3577 4.60913C18.1017 4.60913 17.8657 4.69513 17.6697 4.89113L16.2947 6.23413C15.9047 6.62513 15.9047 7.28112 16.2947 7.67212C16.6857 8.06212 17.3417 8.06212 17.7327 7.67212L19.0757 6.29712C19.4667 5.90612 19.4667 5.28113 19.0757 4.89113C18.8807 4.69513 18.6137 4.60913 18.3577 4.60913ZM12.0137 6.95313C9.25267 6.95313 7.01367 9.19213 7.01367 11.9531C7.01367 14.7141 9.25267 16.9531 12.0137 16.9531C14.7747 16.9531 17.0137 14.7141 17.0137 11.9531C17.0137 9.19213 14.7747 6.95313 12.0137 6.95313ZM12.0137 8.95313C13.6707 8.95313 15.0137 10.2961 15.0137 11.9531C15.0137 13.6101 13.6707 14.9531 12.0137 14.9531C10.3567 14.9531 9.01367 13.6101 9.01367 11.9531C9.01367 10.2961 10.3567 8.95313 12.0137 8.95313ZM3.01367 10.9531C2.46167 10.9531 2.01367 11.4011 2.01367 11.9531C2.01367 12.5051 2.46167 12.9531 3.01367 12.9531H5.01367C5.56567 12.9531 6.01367 12.5051 6.01367 11.9531C6.01367 11.4011 5.56567 10.9531 5.01367 10.9531H3.01367ZM19.0137 10.9531C18.4617 10.9531 18.0137 11.4011 18.0137 11.9531C18.0137 12.5051 18.4617 12.9531 19.0137 12.9531H21.0137C21.5657 12.9531 22.0137 12.5051 22.0137 11.9531C22.0137 11.4011 21.5657 10.9531 21.0137 10.9531H19.0137ZM7.01367 15.9531C6.75767 15.9521 6.49067 16.0391 6.29467 16.2341L4.91968 17.6091C4.52868 17.9991 4.53068 18.6241 4.91968 19.0151C5.30968 19.4071 5.96566 19.4051 6.35766 19.0151L7.73266 17.6721C8.12366 17.2821 8.12166 16.6261 7.73266 16.2341C7.53766 16.0391 7.26967 15.9541 7.01367 15.9531ZM17.0137 15.9531C16.7577 15.9531 16.4897 16.0391 16.2947 16.2341C15.9047 16.6251 15.9037 17.2821 16.2947 17.6721L17.7017 19.0471C18.0917 19.4371 18.7177 19.4381 19.1077 19.0471C19.4977 18.6561 19.4987 17.9991 19.1077 17.6091L17.7327 16.2341C17.5367 16.0391 17.2697 15.9531 17.0137 15.9531ZM12.0137 17.9531C11.4617 17.9531 11.0137 18.4011 11.0137 18.9531V20.9531C11.0137 21.5051 11.4617 21.9531 12.0137 21.9531C12.5657 21.9531 13.0137 21.5051 13.0137 20.9531V18.9531C13.0137 18.4011 12.5657 17.9531 12.0137 17.9531Z" fill="currentColor"/>
        </svg>
      </button>
      <a class="secondaryButton nav__cta" href="/contact">Get in Touch</a>
      </div>
      <button type="button" id="nav-toggle" class="nav__hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-overlay">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
  <div class="nav__overlay" id="nav-overlay" inert>
    <div class="nav__overlay-links">
      <a class="nav__overlay-link" href="/projects">Projects</a>
      <a class="nav__overlay-link" href="/#approach">Approach</a>
      <a class="nav__overlay-link" href="/blog">Blog</a>
      <a class="nav__overlay-link" href="/#clients">Clients</a>
      <a class="nav__overlay-cta" href="/contact">Get in Touch</a>
    </div>
  </div>

  <main class="page-enter">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer__wrapper">
      <span class="footer__copyright">2026 &copy; Nick Ringelmann</span>
      <div class="footer__social">
        <a class="footer__linkedin" href="https://www.linkedin.com/in/nick-ringelmann/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
          <span class="footer__linkedin-icon" style={`--icon: url(${linkedinIcon.src})`}></span>
        </a>
        <a class="footer__github" href="https://github.com/seafyre" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
          <span class="footer__github-icon" style={`--icon: url(${githubIcon.src})`}></span>
        </a>
      </div>
      <div class="footer__links">
        <a class="primaryButton" href="/contact">Contact</a>
        <a class="primaryButton" href="/imprint">Imprint</a>
        <a class="primaryButton" href="/privacy">Privacy</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var nav = document.querySelector('.nav');
      function updateNav() {
        nav.classList.toggle('nav--scrolled', window.scrollY > 0);
      }
      updateNav();
      window.addEventListener('scroll', updateNav, { passive: true });
    })();
  </script>

  <script is:inline>
    (function () {
      var navToggle = document.getElementById('nav-toggle');
      var navOverlay = document.getElementById('nav-overlay');

      function setNav(open) {
        document.body.classList.toggle('nav-open', open);
        document.body.style.overflow = open ? 'hidden' : '';
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        navOverlay.inert = !open;
      }

      function closeNav(refocus) {
        setNav(false);
        if (refocus) navToggle.focus();
      }

      navToggle.addEventListener('click', function () {
        var open = navToggle.getAttribute('aria-expanded') !== 'true';
        setNav(open);
        if (open) navOverlay.querySelector('.nav__overlay-link').focus();
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && navToggle.getAttribute('aria-expanded') === 'true') {
          closeNav(true);
        }
      });

      navOverlay.querySelectorAll('.nav__overlay-link, .nav__overlay-cta').forEach(function (el) {
        el.addEventListener('click', function () {
          closeNav(false);
        });
      });
    })();
  </script>

  <script is:inline>
    document.getElementById('theme-toggle').addEventListener('click', function () {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDark) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
      }
      this.blur();
    });
  </script>

</body>
</html>
