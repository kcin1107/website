---
import Layout from '../layouts/Layout.astro'
---
<Layout title="Contact – Nick Ringelmann">

  <section class="section">
    <div class="container contact-container">
      <div class="contact-grid">

        <div class="contact-intro">
          <h1>Let's <strong>talk</strong>.</h1>
          <p class="subtitle">Want to collaborate, get support, or give feedback on one of my projects? Shoot me a message!</p>
          <p class="contact-direct">Prefer writing directly? <a class="contact-email-link" href="mailto:work@nickringelmann.com">work@nickringelmann.com</a></p>
        </div>

        <form id="contact-form" class="contact-form" novalidate>
          <div class="contact-honeypot" aria-hidden="true">
            <label for="contact-company">Company</label>
            <input type="text" id="contact-company" name="company" tabindex="-1" autocomplete="off">
          </div>

          <div class="contact-row">
            <div class="contact-field">
              <label for="contact-name">Name</label>
              <input type="text" id="contact-name" name="name" autocomplete="name" required>
            </div>

            <div class="contact-field">
              <label for="contact-email">Mail</label>
              <input type="email" id="contact-email" name="email" autocomplete="email" required>
            </div>
          </div>

          <div class="contact-field">
            <span class="contact-field__label">Subject</span>
            <div class="subject-pills" role="radiogroup" aria-label="Subject">
              <input type="radio" id="subject-project" name="subject" value="Project Request" required>
              <label class="tag subject-pill" for="subject-project">Project Request</label>

              <input type="radio" id="subject-scorer" name="subject" value="Scorer (Support/Feedback)" required>
              <label class="tag subject-pill" for="subject-scorer">Scorer (Support/Feedback)</label>

              <input type="radio" id="subject-other" name="subject" value="Something Else" required>
              <label class="tag subject-pill" for="subject-other">Something Else</label>
            </div>
          </div>

          <div class="contact-field" id="contact-subject-other-field" hidden>
            <label for="contact-subject-other-input">Please specify</label>
            <input type="text" id="contact-subject-other-input" name="subject-other">
          </div>

          <div class="contact-field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="5" required></textarea>
          </div>

          <p class="contact-status" id="contact-status" role="status" aria-live="polite"></p>

          <a href="#" id="contact-submit" class="secondaryButton contact-submit">Send Message</a>
        </form>

      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement
    const submit = document.getElementById('contact-submit') as HTMLAnchorElement
    const subjectRadios = document.querySelectorAll<HTMLInputElement>('input[name="subject"]')
    const otherField = document.getElementById('contact-subject-other-field') as HTMLElement
    const otherInput = document.getElementById('contact-subject-other-input') as HTMLInputElement
    const status = document.getElementById('contact-status') as HTMLElement

    function selectedSubject(): string {
      const checked = document.querySelector<HTMLInputElement>('input[name="subject"]:checked')
      if (!checked) return ''
      return checked.value === 'Something Else' ? otherInput.value.trim() : checked.value
    }

    subjectRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        const isOther = radio.value === 'Something Else' && radio.checked
        otherField.hidden = !isOther
        otherInput.required = isOther
        if (!isOther) otherInput.value = ''
      })
    })

    submit.addEventListener('click', (event) => {
      event.preventDefault()

      if (submit.getAttribute('aria-disabled') === 'true') return
      if (!form.reportValidity()) return

      const name = (document.getElementById('contact-name') as HTMLInputElement).value
      const email = (document.getElementById('contact-email') as HTMLInputElement).value
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement).value
      const company = (document.getElementById('contact-company') as HTMLInputElement).value
      const subject = selectedSubject()

      submit.setAttribute('aria-disabled', 'true')
      submit.style.pointerEvents = 'none'
      const originalLabel = submit.textContent
      submit.textContent = 'Sending…'
      status.textContent = ''
      status.classList.remove('contact-status--error')

      fetch('/api/contact.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, subject, message, company }),
      })
        .then(async (response) => {
          const data = await response.json().catch(() => ({}))
          if (!response.ok || !data.ok) throw new Error(data.error || 'Something went wrong.')

          status.textContent = "Thanks, your message is on its way. I'll get back to you soon."
          form.reset()
          otherField.hidden = true
        })
        .catch((error: Error) => {
          status.textContent = `${error.message} You can also mail me directly at work@nickringelmann.com.`
          status.classList.add('contact-status--error')
        })
        .finally(() => {
          submit.removeAttribute('aria-disabled')
          submit.style.pointerEvents = ''
          submit.textContent = originalLabel
        })
    })
  </script>

</Layout>

<style>
  .contact-container {
    gap: 32px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(240px, 340px) 1fr;
    gap: 64px;
    width: 100%;
    align-items: start;
  }

  .contact-intro {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 20px;
    position: sticky;
    top: calc(96px + 32px);
  }

  .contact-intro h1 {
    margin: 0;
  }

  .contact-direct {
    font-size: 0.875rem;
    color: var(--dark-grey);
  }

  .contact-email-link {
    color: var(--black);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .contact-email-link:hover {
    color: #357DFF;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
    background-color: var(--surface-grey);
    padding: 40px;
  }

  .contact-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .contact-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .contact-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-field[hidden] {
    display: none;
  }

  .contact-field label:not(.tag),
  .contact-field__label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .contact-field input,
  .contact-field textarea {
    font-family: 'Roboto', sans-serif;
    font-size: 1rem;
    color: var(--black);
    background-color: var(--white);
    border: 1px solid var(--border-grey);
    padding: 12px 16px;
    resize: vertical;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .contact-field input:focus-visible,
  .contact-field textarea:focus-visible {
    outline: none;
    border-color: #357DFF;
    box-shadow: 0 0 0 3px rgba(53, 125, 255, 0.15);
  }

  .subject-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .subject-pills input[type='radio'] {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    padding: 0;
  }

  .subject-pill {
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    user-select: none;
  }

  .subject-pills input[type='radio']:checked + .subject-pill {
    color: var(--white);
    background-color: var(--black);
    border-color: var(--black);
  }

  .subject-pills input[type='radio']:focus-visible + .subject-pill {
    outline: 2px solid #357DFF;
    outline-offset: 2px;
  }

  .contact-status {
    font-size: 0.8125rem;
    color: var(--dark-grey);
    margin-top: -8px;
    min-height: 1.4em;
  }

  .contact-status--error {
    color: #d9534f;
  }

  #contact-submit {
    align-self: stretch;
    text-align: center;
    padding: 12px 28px;
  }

  @media (hover: hover) and (pointer: fine) {
    .subject-pill:hover {
      border-color: var(--dark-grey);
    }

    .subject-pills input[type='radio']:checked + .subject-pill:hover {
      background-color: color-mix(in srgb, var(--black) 85%, transparent);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact-intro,
    .contact-form {
      animation: contact-rise 0.5s ease-out both;
    }

    .contact-form {
      animation-delay: 0.08s;
    }
  }

  @keyframes contact-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1023px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .contact-intro {
      position: static;
    }

    .contact-form {
      background-color: transparent;
      padding: 0;
    }
  }

  @media (max-width: 767px) {
    .contact-container {
      gap: 24px;
    }

    .contact-form {
      padding: 0;
      gap: 24px;
    }

    .contact-row {
      grid-template-columns: 1fr;
    }
  }
</style>
