---
import Layout from '../layouts/Layout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import ApproachCard from '../components/ApproachCard.astro'
import { projects } from '../data/projects'
import { getCollection } from 'astro:content'
import BlogCard from '../components/BlogCard.astro'
import { Image } from 'astro:assets'
import hero1 from '../assets/images/hero1.jpg'
import hero2 from '../assets/images/hero2.jpg'

const recentPosts = (await getCollection('blog'))
  .filter((post: { data: { draft: boolean } }) => !post.data.draft)
  .sort((a: { data: { date: Date } }, b: { data: { date: Date } }) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const homeProjects = projects.filter(project => project.showOnHome !== false).slice(0, 6)

const approaches = [
  {
    icon: '&#x1F6E0;&#xFE0F;',
    title: 'Lean UX',
    text: "Let's keep it lean and focus on business value over complicated processes that hinder progress.",
  },
  {
    icon: '&#x2699;&#xFE0F;',
    title: 'Systemic thinking',
    text: 'Having a systemic approach to digital products helps to create a consistent user experience.',
  },
  {
    icon: '&#x1F4AC;',
    title: 'Communication is key',
    text: 'Facilitating collaboration also means facilitating process, hence being a part of the team is a must.',
  },
  {
    icon: '&#x267B;&#xFE0F;',
    title: 'Reducing digital trash',
    text: 'Keeping the environmental impact in mind, I aim to keep my designs simple & energy-efficient.',
  },
  {
    icon: '&#x1F532;',
    title: 'Less is more',
    text: 'No matter the viewport: I always strive for an elegant, simplistic, and efficient design language.',
  },
  {
    icon: '&#x1F331;',
    title: 'Driven by sustainability',
    text: 'Passionate about digital products that aim to help humans, animals, aim to reduce impact on nature.',
  },
]

const toolsList = [
  'Figma', 'MCPs', 'Claude Code', 'OpenAI Codex', 'VS Code', 'Xcode', 'Astro.js',
  'Svelte', 'Webflow', 'WordPress', 'Affinity',
]

const designSystems = [
  'Human Interface Guidelines', 'Material Design', 'HeroUI (NextUI)', 'SAP Fiori', 'Tailwind',
]
---
<Layout title="Nick Ringelmann – Product Designer">

  <!-- Hero -->
  <section class="section">
    <div class="container hero-container">
      <div class="hero">
        <div class="hero__images">
          <Image class="hero__image-1 elevation-md" src={hero1} alt="Nick Ringelmann" width={525} height={525} format="webp" densities={[1, 2]} loading="eager" />
          <Image class="hero__image-2 elevation-md" src={hero2} alt="Nick working" width={617} height={411} format="webp" densities={[1, 2]} loading="eager" />
          <div class="status-row status-row--mobile">
            <div class="status">
              <div class="status__dot"></div>
              <span class="status__text">Available</span>
            </div>
            <div class="status status--blue">
              <span class="status__text">&#x1F4CD;</span>
              <span class="status__text">Remote</span>
            </div>
          </div>
        </div>
        <div class="hero__content">
          <div class="status-row status-row--desktop">
            <div class="status">
              <div class="status__dot"></div>
              <span class="status__text">Currently available</span>
            </div>
            <div class="status status--blue">
              <span class="status__text">&#x1F4CD;</span>
              <span class="status__text">Germany & Remote</span>
            </div>
          </div>
          <h1>Hi, I'm Nick, a <strong>Freelance Product Designer</strong> based in Hamburg, Germany.</h1>
          <p class="subtitle">I design clear digital products for teams that care about long-term impact, blending UX and sustainable thinking to make complex services easier to use.</p>
          <div class="hero__links">
            <a class="secondaryButton" href="/contact">Get in Touch</a>
            <a class="primaryButton" href="https://www.linkedin.com/in/nick-ringelmann/" target="_blank">Connect on LinkedIn</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="section" id="projects">
    <div class="container">
      <div class="section-header">
        <h2 class="section__title" style="margin-bottom: 0;">Projects</h2>
        <a class="primaryButton" href="/projects">All Projects</a>
      </div>
      <div class="projects-grid">
        {homeProjects.map(p => (
          <ProjectCard
            image={p.image}
            alt={p.alt}
            title={p.title}
            subtitle={p.client}
            topicTag={p.topicTag}
            tags={p.tags}
            href={p.slug ? `/projects/${p.slug}` : undefined}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section" id="approach">
    <div class="container">
      <h2 class="section__title">Approach</h2>
      <div class="approach-grid">
        {approaches.map(a => <ApproachCard {...a} />)}
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section class="section" id="tools">
    <div class="container">
      <div class="tools-columns">
        <div class="tools-column">
          <h2 class="section__title tools-column__label">Tools</h2>
          <p class="tools-column__list">
            {toolsList.map(t => <span class="tools-item">{t}</span>)}
          </p>
        </div>
        <div class="tools-column">
          <h2 class="section__title tools-column__label">Design Systems</h2>
          <p class="tools-column__list">
            {designSystems.map(t => <span class="tools-item">{t}</span>)}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="section" id="blog">
    <div class="container">
      <div class="section-header">
        <h2 class="section__title" style="margin-bottom: 0;">Blog</h2>
        <a class="primaryButton" href="/blog">All Posts</a>
      </div>
      <div class="blog-grid">
        {recentPosts.map((post: { id: string; data: { title: string; description: string; date: Date } }) => (
          <BlogCard
            href={`/blog/${post.id}/`}
            date={new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(post.data.date)}
            title={post.data.title}
            description={post.data.description}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="section" id="clients">
    <div class="container">
      <h2 class="section__title">Clients</h2>
      <div class="clients-grid">
        <a href="https://www.boomerangpack.eu/" target="_blank" rel="noopener noreferrer">
          <img src="/assets/images/Boomerang.svg" alt="Boomerang company logo" width="128" loading="lazy">
        </a>
        <a href="https://www.loeffelholz-care.de/" target="_blank" rel="noopener noreferrer">
          <img src="/assets/images/Loeffelholz-Care.svg" alt="Löffelholz Care GmbH company logo" width="128" loading="lazy">
        </a>
        <a href="https://www.assetocean.io/" target="_blank" rel="noopener noreferrer">
          <img src="/assets/images/Asset-Ocean.svg" alt="Asset Ocean company logo" width="128" loading="lazy">
        </a>
        <a href="https://www.encavis.com/en" target="_blank" rel="noopener noreferrer">
          <img src="/assets/images/encavis.svg" alt="Encavis AG company logo" width="128" loading="lazy">
        </a>
        <a href="https://www.1300etc.de/" target="_blank" rel="noopener noreferrer">
          <img src="/assets/images/1300ETC.svg" alt="1300ETC racing series logo" width="128" loading="lazy">
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 48px;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
  }

  .tools-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    width: 100%;
  }

  .tools-column {
    text-align: center;
  }

  .tools-column__label {
    display: block;
  }

  .tools-column__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 24px;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--dark-grey);
  }

  .tools-item {
    color: inherit;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .tools-item:hover {
    color: var(--black);
  }

  @media (max-width: 767px) {
    .tools-columns {
      grid-template-columns: 1fr;
      gap: 128px;
    }

    .tools-column {
      text-align: left;
    }

    .tools-column__list {
      justify-content: flex-start;
    }
  }

  @media (max-width: 1023px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
