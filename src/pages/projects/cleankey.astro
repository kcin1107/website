---
import Layout from '../../layouts/Layout.astro'
import AppShowcase from '../../components/AppShowcase.astro'
import Button from '../../components/Button.astro'
import { projects } from '../../data/projects'
import { getCleankeyRelease } from '../../data/app-releases'

const cleankey = projects.find(project => project.slug === 'cleankey')!
const links = cleankey.links ?? []
const release = await getCleankeyRelease()
---
<Layout
  title="Cleankey – Clean Your Keyboard · Nick Ringelmann"
  description={cleankey.lead}
>
  <AppShowcase
    icon={cleankey.appIcon!.src}
    title="Cleankey"
    tagline="Lock every key from the menu bar while you wipe your keyboard."
    version={`Version ${release.version} · Free · macOS 14 or later`}
  >
    <Fragment slot="actions">
      {links.map(link => (
        <Button
          href={link.href}
          variant={link.variant}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </Button>
      ))}
    </Fragment>

    <img
      class="app-showcase__demo"
      src="/assets/images/cleankey-demo-20260818.gif"
      alt="Cleankey's menu bar switch turning keyboard cleaning on and off"
      width="960"
      height="582"
      loading="eager"
    />
  </AppShowcase>
</Layout>
