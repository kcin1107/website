---
import Layout from '../../layouts/Layout.astro'
import Button from '../../components/Button.astro'
import { Image } from 'astro:assets'
import { projects } from '../../data/projects'

export function getStaticPaths() {
  return projects
    .filter(project => project.slug)
    .map(project => ({
      params: { slug: project.slug },
      props: { project },
    }))
}

const { project } = Astro.props
const mobileImage = project.mobileImage
const desktopImages = project.images ?? []
const hasShowcase = Boolean(mobileImage && desktopImages.length)
const singleImage = !hasShowcase
  ? (project.images?.[0] ?? (project.image ? { src: project.image, alt: project.alt } : undefined))
  : undefined
const descriptionParagraphs = (project.description ?? 'This is a project description').split('\n\n')
---
<Layout title={`${project.title} – ${project.client} · Nick Ringelmann`}>

  <section class="section">
    <div class="container project-detail">

      <!-- Back link -->
      <Button class="project-detail__back" href="/projects" icon>Back to Projects</Button>

      <!-- Header -->
      <div class="project-detail__header">
        <div class="project-detail__titles">
          <h1 class="project-detail__title">{project.title}</h1>
          <span class="project-detail__client">{project.client}</span>
        </div>
        <div class="project-detail__tags">
          <span class="tag tag--topic">{project.topicTag}</span>
          {project.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      </div>

      <!-- Description -->
      <div class="project-detail__description">
        {descriptionParagraphs.map(paragraph => <p class="text-md">{paragraph}</p>)}
      </div>

      <!-- Preview images -->
      <div class="project-detail__images">
        {hasShowcase && mobileImage ? (
          <div class="project-detail__showcase">
            <div class="project-detail__showcase-mobile">
              <Image src={mobileImage.src} alt={mobileImage.alt} width={400} format="webp" densities={[1, 2]} />
            </div>
            {desktopImages.map(image => (
              <div class="project-detail__showcase-item">
                <Image src={image.src} alt={image.alt} width={800} format="webp" densities={[1, 2]} />
              </div>
            ))}
          </div>
        ) : singleImage && (
          <div class="project-detail__image-wrapper">
            <Image class="project-detail__image" src={singleImage.src} alt={singleImage.alt} width={720} format="webp" densities={[1, 2]} />
          </div>
        )}
      </div>

    </div>
  </section>

</Layout>

