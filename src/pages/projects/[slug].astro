---
import Layout from '../../layouts/Layout.astro'
import Button from '../../components/Button.astro'
import ProjectSection from '../../components/ProjectSection.astro'
import ResultLines from '../../components/ResultLines.astro'
import FramingNudge from '../../components/FramingNudge.astro'
import ShippingNudge from '../../components/ShippingNudge.astro'
import { Image } from 'astro:assets'
import { projects } from '../../data/projects'
import '../../styles/project-detail.css'

export function getStaticPaths() {
  return projects
    .filter(project => project.slug)
    .map(project => ({
      params: { slug: project.slug },
      props: { project },
    }))
}

const embeds = {
  'result-lines': ResultLines,
  'framing-nudge': FramingNudge,
  'shipping-nudge': ShippingNudge,
}

const { project } = Astro.props
const mobileImage = project.mobileImage
const desktopImages = project.images ?? []
const hasShowcase = Boolean(mobileImage && desktopImages.length)
const singleImage = !hasShowcase
  ? (project.images?.[0] ?? (project.image ? { src: project.image, alt: project.alt } : undefined))
  : undefined
const descriptionParagraphs = (project.description ?? 'This is a project description').split('\n\n')
const hasSections = Boolean(project.sections?.length)
/* On a case study, `lead` opens the page and the sections carry the rest, so the
   legacy placeholder has nothing to say. A real `description` still renders if one
   is set, and pages without sections keep the old fallback untouched. */
const showDescription = Boolean(project.description) || !hasSections
const meta = (project.meta ?? []).filter(item => item.value.trim() !== '')
/* `lead` is the one-paragraph summary a case study opens with, which is what a
   search result should show. Older entries without one fall back to the tags. */
const metaDescription = project.lead
  ?? `${project.title} for ${project.client}. ${project.tags.join(', ')}.`
---
<Layout title={`${project.title} – ${project.client} · Nick Ringelmann`} description={metaDescription}>

  <section class="section">
    <div class="container project-detail">

      <!-- Back link -->
      <Button class="project-detail__back" href="/projects" icon>Back to Projects</Button>

      <!-- Mobile lead image: first desktop shot, shown between back link and header on small screens -->
      {!hasSections && hasShowcase && desktopImages[0] && (
        <div class="project-detail__mobile-lead">
          <div class="project-detail__showcase-item">
            <Image src={desktopImages[0].src} alt={desktopImages[0].alt} width={800} format="webp" densities={[1, 2]} />
          </div>
        </div>
      )}

      <!-- Header -->
      <div class="project-detail__header">
        <div class="project-detail__identity">
          {project.appIcon && (
            <div class="project-detail__app-icon">
              <Image
                src={project.appIcon.src}
                alt={project.appIcon.alt}
                width={80}
                densities={[1, 2]}
                format="webp"
              />
            </div>
          )}
          <div class="project-detail__titles">
            <h1 class="project-detail__title">{project.title}</h1>
            <span class="project-detail__client">{project.client}</span>
          </div>
        </div>
        <div class="project-detail__tags">
          {project.topicTag && <span class="tag tag--topic">{project.topicTag}</span>}
          {project.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      </div>

      {project.lead && <p class="text-md">{project.lead}</p>}

      {project.links?.length > 0 && (
        <nav class="project-detail__links" aria-label="Project links">
          {project.links.map(link => (
            <Button
              href={link.href}
              variant={link.variant}
              disabled={link.pending || !link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </Button>
          ))}
        </nav>
      )}

      {meta.length > 0 && (
        <dl class="project-detail__meta">
          {meta.map(item => (
            <div class="project-detail__meta-item">
              <dt class="text-sm project-detail__meta-label">{item.label}</dt>
              <dd class="text-md project-detail__meta-value">{item.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <!-- Description -->
      {showDescription && (
        <div class="project-detail__description">
          {descriptionParagraphs.map(paragraph => <p class="text-md">{paragraph}</p>)}
        </div>
      )}

      {/* Case study sections, replacing the image block entirely when present */}
      {hasSections && (
        <div class="project-detail__sections">
          {project.sections!.map((section) => {
            if (section.kind === 'embed') {
              const Component = embeds[section.name]
              return (
                <ProjectSection section={section}>
                  <Component />
                </ProjectSection>
              )
            }
            return <ProjectSection section={section} />
          })}
        </div>
      )}

      <!-- Preview images -->
      {!hasSections && (
        <div class="project-detail__images">
          {hasShowcase && mobileImage ? (
            <div class="project-detail__showcase">
              <div class="project-detail__showcase-mobile">
                <Image src={mobileImage.src} alt={mobileImage.alt} width={400} format="webp" densities={[1, 2]} />
              </div>
              {desktopImages.map((image, i) => (
                <div class={`project-detail__showcase-item${i === 0 ? ' project-detail__showcase-item--lead' : ''}`}>
                  <Image src={image.src} alt={image.alt} width={800} format="webp" densities={[1, 2]} />
                </div>
              ))}
            </div>
          ) : singleImage && (
            <div class="project-detail__image-wrapper">
              <Image class="project-detail__image" src={singleImage.src} alt={singleImage.alt} width={720} format="webp" densities={[1, 2]} />
            </div>
          )}
        </div>
      )}

    </div>
  </section>

</Layout>
