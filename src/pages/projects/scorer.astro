---
import Layout from '../../layouts/Layout.astro'
import AppShowcase from '../../components/AppShowcase.astro'
import { Image } from 'astro:assets'
import { projects } from '../../data/projects'
import icon from '../../assets/images/projects/scorer-v13/icon.png'
import scoringPhone from '../../assets/images/projects/scorer-v13/iPhone2-device.png'
import scoringPad from '../../assets/images/projects/scorer-v13/iPad2-device.png'

const scorer = projects.find(project => project.slug === 'scorer')!
const appStoreUrl = scorer.links?.find(link => link.external)?.href ?? 'https://apple.co/4A4hy3g'
---
<Layout
  title="Scorer – Darts scoring for iPhone and iPad · Nick Ringelmann"
  description="Scorer is a native X01 darts app for iPhone and iPad. Play locally, against a computer, or online with friends. No ads and no account."
>
  <AppShowcase
    icon={icon}
    title="Scorer"
    tagline="Darts scoring for iPhone and iPad. No ads, no account."
    version="Version 1.3.1 · 1,99 € on the App Store"
  >
    <a slot="actions" class="app-showcase__store" href={appStoreUrl} target="_blank" rel="noopener noreferrer" aria-label="Get Scorer on the App Store (opens in a new tab)">
      <img src="/assets/images/app-store-badge.svg" alt="Download on the App Store" width="119" height="40" />
    </a>

    <div class="devices">
      <Image
        class="devices__pad"
        src={scoringPad}
        alt="Scorer on an iPad in landscape, showing four player score cards beside the keypad"
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 767px) calc(100vw - 48px), 840px"
        format="webp"
        loading="eager"
      />
      <Image
        class="devices__phone"
        src={scoringPhone}
        alt="Scorer's live 501 game screen on iPhone, with the active player, scores and number keypad"
        widths={[240, 360, 480]}
        sizes="(max-width: 767px) 26vw, 250px"
        format="webp"
        loading="eager"
      />
    </div>

    <p slot="footer" class="app-showcase__footer">Questions about your data? <a href="/scorer/privacy">Scorer privacy policy</a>.</p>
  </AppShowcase>
</Layout>
