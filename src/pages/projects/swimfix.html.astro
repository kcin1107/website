---
import Layout from '../../layouts/Layout.astro'
import TabGroup from '../../components/TabGroup.astro'
import TabItem from '../../components/TabItem.astro'
import '../../features/swimfix/ui/embedded.css'

const url = 'https://nickringelmann.com/projects/swimfix.html'
const title = 'SwimFix – FIT File Fix for Garmin Pool Swimming'
const description = 'Fix miscounted pool lengths, rests and stroke types in Garmin swim FIT files. SwimFix is a free FIT file editor that runs locally in your browser, without uploads.'
const content = {
  en: {
    tagline: 'FIT file fix for Garmin pool swimming',
    intro: 'Your watch counted too many lengths? Fix pool lengths, rests and stroke types in your Garmin FIT file right in your browser. Free, no account and no file upload.',
    aboutLabel: 'Edit Garmin swim FIT files',
    aboutTitle: 'When one length becomes two.',
    paragraphs: [
      'During a pool swim, your watch may detect an extra turn or count a rest as an active length. The recorded distance, pace and SWOLF can then differ from your actual swim. SwimFix helps you review and correct those lengths.',
      'The automatic check compares length times and stroke counts, highlights unusual sections and suggests merges or rests. You decide which changes fit your swim. You can also select lengths manually, change stroke types and undo edits before downloading a corrected FIT file.',
      'Your activity stays in your browser’s memory. There is no upload, sign-in or analytics script on this page. Download the edited file before closing or reloading the page; your original file is never overwritten.',
    ],
    faqLabel: 'Questions & answers',
    faqTitle: 'Editing a FIT file: common questions',
    faqs: [
      { question: 'What can SwimFix fix in a FIT file?', answer: 'SwimFix edits pool-swimming activities in Garmin FIT files. You can merge two adjacent lengths within the same interval, mark a falsely detected swimming length as rest, or change a stroke type. Distance and the related swimming metrics are recalculated after each correction.' },
      { question: 'How does this FIT file fix work?', answer: 'Choose the exported FIT file from your swim. SwimFix looks for unusually short lengths and suggests corrections. Review those suggestions or select lengths yourself, then download a new FIT file with _swimfix added to its name. The original remains unchanged.' },
      { question: 'Is my swim activity uploaded or stored?', answer: 'No. Your FIT file is read and edited only in your browser’s memory. There is no file upload, account or analytics script on this page. Save the edited file before closing or reloading the page.' },
      { question: 'Can SwimFix repair corrupted FIT files?', answer: 'SwimFix focuses on miscounted lengths in readable pool-swimming files. It does not recover corrupted files or edit running, cycling or open-water activities. Compressed timestamps and chained FIT files are not currently supported.' },
      { question: 'Does editing change heart rate, calories or total time?', answer: 'Total time, heart-rate records, calories and other untouched records are preserved. Metrics derived from swimming lengths are recalculated, including distance, active lengths, strokes, pace and SWOLF. You can undo each edit.' },
    ],
  },
  de: {
    tagline: 'FIT File Fix für Garmin-Schwimmaktivitäten',
    intro: 'Deine Uhr hat zu viele Bahnen gezählt? Korrigiere Schwimmbahnen, Pausen und Schwimmstile in deiner Garmin-FIT-Datei direkt im Browser. Kostenlos, ohne Anmeldung und ohne Datei-Upload.',
    aboutLabel: 'Garmin-FIT-Dateien korrigieren',
    aboutTitle: 'Wenn aus einer Bahn zwei werden.',
    paragraphs: [
      'Bei einer Pool-Schwimmeinheit kann die Uhr einen zusätzlichen Bahnwechsel erkennen oder eine Pause als aktive Länge zählen. Dadurch passen Distanz, Tempo und SWOLF nicht mehr zur tatsächlich geschwommenen Strecke. SwimFix hilft dir, diese Aufzeichnungen gezielt zu bearbeiten.',
      'Die automatische Prüfung vergleicht Zeiten und Züge deiner Längen. Sie zeigt auffällige Abschnitte und schlägt Zusammenlegungen oder Pausen vor. Du entscheidest, welche Änderungen passen. Du kannst Längen auch manuell auswählen, den Schwimmstil ändern und Bearbeitungen vor dem Download rückgängig machen.',
      'Deine Aktivität bleibt im Arbeitsspeicher deines Browsers. Es gibt keinen Upload, keine Anmeldung und auf dieser Seite kein Analytics-Skript. Lade die bearbeitete Datei vor dem Schließen oder Neuladen der Seite herunter; das Original wird nicht überschrieben.',
    ],
    faqLabel: 'Fragen & Antworten',
    faqTitle: 'FIT-Datei bearbeiten: häufige Fragen',
    faqs: [
      { question: 'Was kann ich mit SwimFix an einer FIT-Datei korrigieren?', answer: 'SwimFix bearbeitet Pool-Schwimmaktivitäten aus Garmin-FIT-Dateien. Du kannst zwei benachbarte Längen im selben Intervall zusammenlegen, eine fälschlich erkannte Schwimmbahn als Pause markieren oder den Schwimmstil ändern. Anschließend werden Distanz und die davon abhängigen Schwimmkennzahlen neu berechnet.' },
      { question: 'Wie funktioniert der FIT File Fix?', answer: 'Wähle die exportierte FIT-Datei deiner Schwimmaktivität aus. SwimFix sucht nach ungewöhnlich kurzen Längen und schlägt passende Korrekturen vor. Prüfe diese Vorschläge oder wähle Längen manuell aus. Anschließend lädst du eine neue FIT-Datei mit dem Zusatz _swimfix herunter. Das Original bleibt unverändert.' },
      { question: 'Wird meine Aktivität hochgeladen oder gespeichert?', answer: 'Nein. Deine FIT-Datei wird ausschließlich im Arbeitsspeicher deines Browsers gelesen und bearbeitet. Es gibt keinen Datei-Upload, keine Anmeldung und auf dieser Seite kein Analytics-Skript. Speichere die bearbeitete Datei vor dem Schließen oder Neuladen der Seite.' },
      { question: 'Kann SwimFix auch beschädigte FIT-Dateien reparieren?', answer: 'Der Schwerpunkt liegt auf falsch gezählten Schwimmbahnen in lesbaren Pool-Schwimmdateien. SwimFix stellt keine beschädigten Dateien wieder her und bearbeitet keine Lauf-, Rad- oder Freiwasseraktivitäten. Komprimierte Zeitstempel und verkettete FIT-Dateien werden derzeit nicht unterstützt.' },
      { question: 'Werden Puls, Kalorien und die Gesamtzeit geändert?', answer: 'Gesamtzeit, Pulsdaten, Kalorien und weitere unberührte Aufzeichnungen bleiben erhalten. Neu berechnet werden die von den Schwimmlängen abhängigen Werte, darunter Distanz, aktive Längen, Züge, Tempo und SWOLF. Jede Korrektur lässt sich rückgängig machen.' },
    ],
  },
}
const languages = ['en', 'de'] as const
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${url}#app`,
  name: 'SwimFix',
  alternateName: 'SwimFix FIT File Fix',
  url,
  description,
  applicationCategory: 'SportsApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript and a modern web browser',
  inLanguage: ['en', 'de'],
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  creator: { '@type': 'Person', name: 'Nick Ringelmann', url: 'https://nickringelmann.com/' },
  featureList: ['Edit Garmin pool-swimming FIT files', 'Merge adjacent lengths', 'Correct rests and stroke types', 'Local processing without uploads', 'Download an edited FIT file'],
}
---
<Layout title={title} description={description} canonicalPath="/projects/swimfix.html" analytics={false}>
  <section id="swimfix-page" class="swimfix-page" lang="en" aria-labelledby="swimfix-title">
    <div class="swimfix-page__heading">
      <h1 id="swimfix-title">SwimFix</h1>
      <div class="swimfix-page__languages" role="group" aria-label="Language">
        <TabGroup>
          <TabItem label="EN" selected id="swimfix-tab-en" data-swimfix-language="en" aria-controls="swimfix-content" tabindex="0" />
          <TabItem label="DE" id="swimfix-tab-de" data-swimfix-language="de" aria-controls="swimfix-content" tabindex="-1" />
        </TabGroup>
      </div>
    </div>
    <div id="swimfix-content" role="tabpanel" aria-labelledby="swimfix-tab-en">
      {languages.map(language => (
        <header class="swimfix-page__hero" data-swimfix-copy={language} lang={language} hidden={language !== 'en'}>
          <p class="swimfix-page__eyebrow">{content[language].tagline}</p>
          <p>{content[language].intro}</p>
        </header>
      ))}
      <div class="swimfix-tool">
        <div id="swimfix-app" data-embedded="true" data-language="en"></div>
        <noscript>Enable JavaScript to edit a FIT file locally in your browser.</noscript>
      </div>
      {languages.map(language => (
        <div data-swimfix-copy={language} lang={language} hidden={language !== 'en'}>
          <section class="swimfix-page__info" aria-labelledby={`swimfix-about-${language}`}>
            <div>
              <p class="swimfix-page__eyebrow">{content[language].aboutLabel}</p>
              <h2 id={`swimfix-about-${language}`}>{content[language].aboutTitle}</h2>
            </div>
            <div class="swimfix-page__prose">
              {content[language].paragraphs.map(paragraph => <p>{paragraph}</p>)}
            </div>
          </section>
          <section class="swimfix-page__faq" aria-labelledby={`swimfix-faq-${language}`}>
            <p class="swimfix-page__eyebrow">{content[language].faqLabel}</p>
            <h2 id={`swimfix-faq-${language}`}>{content[language].faqTitle}</h2>
            {content[language].faqs.map(({ question, answer }) => (
              <details><summary>{question}</summary><p>{answer}</p></details>
            ))}
          </section>
        </div>
      ))}
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Layout>

<script>
  import '../../features/swimfix/ui/app'

  const page = document.getElementById('swimfix-page')!
  const panel = document.getElementById('swimfix-content')!
  const app = document.getElementById('swimfix-app')!
  const tabs = [...page.querySelectorAll<HTMLButtonElement>('[data-swimfix-language]')]
  const metadata = {
    en: {
      title: 'SwimFix – FIT File Fix for Garmin Pool Swimming',
      description: 'Fix miscounted pool lengths, rests and stroke types in Garmin swim FIT files. SwimFix is a free FIT file editor that runs locally in your browser, without uploads.',
    },
    de: {
      title: 'SwimFix – FIT File Fix für Garmin-Schwimmdateien',
      description: 'SwimFix korrigiert falsch gezählte Bahnen, Pausen und Schwimmstile in Garmin-FIT-Dateien. Kostenloser FIT File Fix im Browser – ohne Upload.',
    },
  }

  function selectLanguage(language: 'en' | 'de') {
    page.lang = language
    page.querySelector('.swimfix-page__languages')?.setAttribute('aria-label', language === 'en' ? 'Language' : 'Sprache')
    panel.setAttribute('aria-labelledby', `swimfix-tab-${language}`)
    tabs.forEach(tab => {
      const selected = tab.dataset.swimfixLanguage === language
      tab.setAttribute('aria-selected', String(selected))
      tab.tabIndex = selected ? 0 : -1
      tab.classList.toggle('tab-item--selected', selected)
    })
    page.querySelectorAll<HTMLElement>('[data-swimfix-copy]').forEach(copy => {
      copy.hidden = copy.dataset.swimfixCopy !== language
    })
    document.title = metadata[language].title
    for (const selector of ['meta[name="description"]', 'meta[property="og:description"]']) {
      document.querySelector(selector)?.setAttribute('content', metadata[language].description)
    }
    document.querySelector('meta[property="og:title"]')?.setAttribute('content', metadata[language].title)
    app.dispatchEvent(new CustomEvent('swimfix:languagechange', { detail: { language } }))
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectLanguage(tab.dataset.swimfixLanguage as 'en' | 'de'))
    tab.addEventListener('keydown', event => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return
      event.preventDefault()
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1
        : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length
      const target = tabs[next]
      selectLanguage(target.dataset.swimfixLanguage as 'en' | 'de')
      target.focus()
    })
  })
</script>

<style>
  .swimfix-page { max-width: 1248px; padding: 0 24px; margin: 64px auto 96px; }
  .swimfix-page__heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
  .swimfix-page__heading h1 { margin: 0; }
  .swimfix-page__hero { max-width: 800px; margin-bottom: 48px; }
  .swimfix-page__hero > p:last-child { max-width: 680px; color: var(--dark-grey); font-size: 18px; line-height: 1.5; }
  .swimfix-page__eyebrow { margin-bottom: 16px; color: var(--status-green); font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .swimfix-page__info { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 80px; padding-top: 32px; border-top: 1px solid var(--border-grey); }
  .swimfix-page__prose { max-width: 640px; }
  .swimfix-page__prose p { margin-bottom: 16px; line-height: 1.6; }
  .swimfix-page__faq { max-width: 800px; margin-top: 64px; }
  .swimfix-page__faq h2 { margin-bottom: 24px; }
  .swimfix-page__faq details { border-top: 1px solid var(--border-grey); }
  .swimfix-page__faq details:last-child { border-bottom: 1px solid var(--border-grey); }
  .swimfix-page__faq summary { padding: 16px 0; cursor: pointer; font-weight: 400; }
  .swimfix-page__faq details p { padding: 0 0 24px; max-width: 720px; color: var(--dark-grey); line-height: 1.6; }
  @media (max-width: 767px) {
    .swimfix-page { margin: 32px auto 64px; }
    .swimfix-page__hero { margin-bottom: 32px; }
    .swimfix-page__hero > p:last-child { font-size: 16px; }
    .swimfix-page__info { grid-template-columns: 1fr; gap: 16px; margin-top: 48px; }
    .swimfix-page__faq { margin-top: 48px; }
  }
</style>
