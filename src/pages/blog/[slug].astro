---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} – Nick Ringelmann`} description={post.data.description}>

  <section class="section">
    <div class="container blog-article">
      <h1>{post.data.title}</h1>
      <div class="blog-article__body">
        <Content />
      </div>
    </div>
  </section>

</Layout>

<style>
  .blog-article {
    max-width: 68ch;
  }

  .blog-article__body {
    width: 100%;
    margin-top: 48px;
  }

  /* Images and code blocks are allowed to break out of the text column,
     up to 1000px, regardless of the (now text-width) container. */
  .blog-article__body :global(img),
  .blog-article__body :global(pre) {
    width: min(1000px, calc(100vw - 48px));
    max-width: none;
    margin-left: 50%;
    transform: translateX(-50%);
  }

  .blog-article__body :global(pre) {
    overflow-x: auto;
  }

  .blog-article__body :global(h2) {
    font-size: 1.5rem;
    font-weight: 400;
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .blog-article__body :global(p) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--black);
    margin-bottom: 16px;
  }

  .blog-article__body :global(ul),
  .blog-article__body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 16px;
  }

  .blog-article__body :global(ul) {
    list-style: disc;
  }

  .blog-article__body :global(ol) {
    list-style: decimal;
  }

  .blog-article__body :global(li) {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 6px;
  }

</style>
