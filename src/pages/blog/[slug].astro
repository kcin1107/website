---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatter = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
});
---

<Layout title={`${post.data.title} – Nick Ringelmann`} description={post.data.description}>

  <section class="section">
    <div class="container blog-article">
      <Button class="blog-article__back" href="/blog" icon>Back to Blog</Button>
      <h1 class="blog-article__title">{post.data.title}</h1>
      <p class="blog-article__date">{formatter.format(post.data.date)}</p>
      <div class="blog-article__body">
        <Content />
      </div>
    </div>
  </section>

</Layout>

<style>
  .blog-article {
    max-width: 1200px;
  }

  .blog-article__back {
    align-self: flex-start;
    margin-bottom: 48px;
  }

  .blog-article__title {
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .blog-article__date {
    font-size: 0.9rem;
    color: var(--dark-grey);
    margin: 0 0 48px;
  }

  .blog-article__body {
    width: 100%;
    max-width: 68ch;
    margin: 0 auto;
  }

  /* Images and code blocks are allowed to break out of the text column,
     up to the width of the surrounding container. */
  .blog-article__body :global(img),
  .blog-article__body :global(pre) {
    width: min(1000px, calc(100vw - 48px));
    max-width: none;
    margin-left: 50%;
    transform: translateX(-50%);
  }

  .blog-article__body :global(pre) {
    overflow-x: auto;
  }

  .blog-article__body :global(h2) {
    font-size: 1.5rem;
    font-weight: 400;
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .blog-article__body :global(p) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--black);
    margin-bottom: 16px;
  }

  .blog-article__body :global(ul),
  .blog-article__body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 16px;
  }

  .blog-article__body :global(ul) {
    list-style: disc;
  }

  .blog-article__body :global(ol) {
    list-style: decimal;
  }

  .blog-article__body :global(li) {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 6px;
  }

  @media (max-width: 767px) {
    .blog-article__title {
      font-size: 1.75rem;
    }
  }
</style>
