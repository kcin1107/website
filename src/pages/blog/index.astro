---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatter = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
});
---

<Layout title="Blog – Nick Ringelmann">

  <section class="section">
    <div class="container">
      <h1 class="section__title">Blog</h1>
      <ul class="blog-list">
        {posts.map((post) => (
          <li>
            <a class="blog-card" href={`/blog/${post.id}/`}>
              <div class="blog-card__meta">
                <span class="blog-card__date">{formatter.format(post.data.date)}</span>
              </div>
              <h2 class="blog-card__title">{post.data.title}</h2>
              <p class="blog-card__desc">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Layout>

<style>
  .blog-list {
    display: grid;
    gap: 16px;
    width: 100%;
    max-width: 820px;
  }

  .blog-card {
    display: block;
    padding: 24px;
    background-color: var(--light-grey);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.2s ease-out;
  }

  .blog-card:hover {
    background-color: #ebebeb;
  }

  :global([data-theme='dark']) .blog-card:hover {
    background-color: var(--hover-grey);
  }

  .blog-card__meta {
    margin-bottom: 8px;
  }

  .blog-card__date {
    font-size: 0.875rem;
    color: var(--dark-grey);
  }

  .blog-card__title {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .blog-card__desc {
    font-size: 1rem;
    color: var(--dark-grey);
    line-height: 1.5;
    margin: 0;
  }
</style>
