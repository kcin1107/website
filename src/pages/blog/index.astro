---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatter = new Intl.DateTimeFormat('en-US', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
});
---

<Layout
  title="Blog – Nick Ringelmann"
  description="Notes on product design, research and building things for the web, written by Nick Ringelmann."
>

  <section class="section">
    <div class="container blog-index">
      <h1>Blog</h1>
      <ul class="blog-list">
        {posts.map((post) => (
          <li>
            <a class="blog-list__link" href={`/blog/${post.id}/`}>
              <time class="blog-list__date" datetime={post.data.date.toISOString()}>
                {formatter.format(post.data.date)}
              </time>
              <span class="blog-list__title">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Layout>

<style>
  .blog-index {
    max-width: 68ch;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: 48px;
  }

  .blog-list__link {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    text-decoration: none;
    color: inherit;
  }

  .blog-list__link:hover .blog-list__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-list__date {
    flex-shrink: 0;
    font-size: 0.875rem;
    font-style: italic;
    color: var(--dark-grey);
  }

  .blog-list__title {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.4;
  }

  @media (max-width: 767px) {
    .blog-list__link {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
  }
</style>
