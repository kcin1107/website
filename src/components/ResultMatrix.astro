---
/*
  The finding, at actual scale. 54 participants split into two arms of 27,
  one cell per person, filled where that person ordered with reusable
  packaging. Showing all 54 cells keeps the small sample visible instead of
  hiding it behind a percentage.

  Numbers are hardcoded because this component is wired through the `embed`
  registry in [slug].astro, which passes no props.
*/
const ARM_SIZE = 27

const arms = [
  { label: 'Current integration', chose: 6 },
  { label: 'Redesign', chose: 15 },
]

const summary = arms.map(arm => `${arm.label}: ${arm.chose} of ${ARM_SIZE}`).join('. ')
---
<figure class="matrix">
  <div class="matrix__arms" role="img" aria-label={`Reusable orders per test arm. ${summary}.`}>
    {arms.map(arm => (
      <div class="matrix__arm">
        <div class="matrix__head">
          <span class="matrix__label">{arm.label}</span>
          <span class="matrix__count">{arm.chose} of {ARM_SIZE}</span>
        </div>
        <div class="matrix__grid">
          {Array.from({ length: ARM_SIZE }, (_, i) => (
            <span
              class={`matrix__cell${i < arm.chose ? ' matrix__cell--filled' : ''}`}
              style={`--i:${i}`}
            ></span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <figcaption class="text-sm matrix__caption">
    <span class="matrix__key" aria-hidden="true"></span>
    Each cell is one participant. Filled cells ordered with reusable packaging.
  </figcaption>
</figure>

<style>
  .matrix {
    --accent: #0A7A3C;
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    width: 100%;
  }

  :global([data-theme='dark']) .matrix {
    --accent: #41E788;
  }

  .matrix__arms {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    max-width: 720px;
  }

  .matrix__arm {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .matrix__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .matrix__label {
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .matrix__count {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--dark-grey);
    font-variant-numeric: tabular-nums;
  }

  /* 27 columns at any width: the cells shrink rather than wrapping, so the
     two arms stay directly comparable down to 390px. */
  .matrix__grid {
    display: grid;
    grid-template-columns: repeat(27, 1fr);
    gap: 4px;
  }

  .matrix__cell {
    aspect-ratio: 1;
    border: 1px solid var(--border-interactive);
    border-radius: 2px;
  }

  .matrix__cell--filled {
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .matrix__caption {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--dark-grey);
  }

  .matrix__key {
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background-color: var(--accent);
  }

  @media (max-width: 767px) {
    .matrix__grid {
      gap: 2px;
    }
  }

  /* The fill is the finding, so it is the one thing on this page that moves.
     Empty cells paint immediately; only the filled ones arrive, left to
     right, once the matrix is in view. */
  @media (prefers-reduced-motion: no-preference) {
    .matrix__cell--filled {
      background-color: transparent;
      border-color: var(--border-interactive);
      transition:
        background-color 300ms ease-out,
        border-color 300ms ease-out;
      transition-delay: calc(var(--i) * 12ms);
    }

    .matrix--in-view .matrix__cell--filled {
      background-color: var(--accent);
      border-color: var(--accent);
    }
  }
</style>

<script>
  const matrices = document.querySelectorAll<HTMLElement>('.matrix')

  if (matrices.length) {
    const reveal = (el: HTMLElement) => el.classList.add('matrix--in-view')

    if (!('IntersectionObserver' in window)) {
      matrices.forEach(reveal)
    } else {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return
            reveal(entry.target as HTMLElement)
            obs.unobserve(entry.target)
          })
        },
        { threshold: 0.35 },
      )

      matrices.forEach(el => observer.observe(el))
    }
  }
</script>
