<div class="tab-group" role="tablist">
  <slot />
</div>

<style>
  .tab-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px;
    background-color: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: 16px;
  }

  /* Dark mode */
  :global([data-theme='dark']) .tab-group {
    background-color: var(--light-grey);
    border-color: var(--border-grey);
  }
</style>
