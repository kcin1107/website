---
/*
  The social reference nudge, rebuilt as markup. Copy is verbatim from the
  Figma component (node 171:1301), including the tooltip, which is shown in
  its open state rather than waiting on a hover that will never happen.

  The radios are styled spans. Nothing here is focusable and there are no form
  controls, because this is a picture of an interface rather than one.
*/
const legend = [
  { lever: 'A real choice.', text: 'One radio, at the step where people decide how a parcel arrives. In the shops I audited, reusable was a cart line item with a quantity stepper, so nothing stopped you buying three.' },
  { lever: 'No penalty.', text: 'Priced identically to standard shipping. The deposit is the only difference, and it comes back.' },
  { lever: 'Social reference.', text: 'A count of how many people picked it yesterday. This line is the nudge.' },
  { lever: 'Education.', text: 'The deposit question, answered at the point it gets asked.' },
]
---
<figure class="nudge shipping">
  <div class="shipping__group">
    <div class="shipping__option">
      <span class="shipping__radio shipping__radio--on" aria-hidden="true"></span>
      <span class="shipping__labels">
        <span class="shipping__label">Standard</span>
        <span class="text-sm shipping__desc">2 to 4 workdays</span>
      </span>
      <span class="shipping__price">3,90 €</span>
    </div>

    <div class="shipping__option shipping__option--nudged">
      <span class="shipping__radio" aria-hidden="true">
        <span class="nudge__badge shipping__radio-badge">1</span>
      </span>
      <span class="shipping__labels">
        <span class="shipping__label">
          Reusable shipping (+ 3 € deposit)
          <span class="shipping__info" aria-hidden="true">i</span>
        </span>
        <span class="text-sm shipping__desc">2 to 4 workdays</span>
        <span class="text-sm shipping__social">
          <span class="nudge__badge shipping__social-badge" aria-hidden="true">3</span>
          <svg class="shipping__leaf" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M20 4c0 9.5-5 14-11 14a6.9 6.9 0 0 1-3.2-.7c1.6-4.4 4.7-7.2 8.2-8.6-3.9.9-7.3 3.4-9.3 7.7C3.3 14.6 3 12.7 3 11 3 6.6 7.9 4 13 4z" />
          </svg>
          Yesterday, 41 of our customers used our environmentally friendly reusable shipping from
          Boomerang. Help to make online trade greener and reduce the burden on the environment!
        </span>
      </span>
      <span class="shipping__price shipping__price--marked">
        <span class="nudge__badge shipping__price-badge" aria-hidden="true">2</span>
        3,90 €
      </span>
    </div>
  </div>

  <p class="text-sm shipping__tooltip">
    <span class="nudge__badge shipping__tooltip-badge" aria-hidden="true">4</span>
    The deposit amount is <strong>automatically</strong> refunded to you after you return the
    packaging. You can fold the packaging and put it in any letterbox for free. In this way, we can
    save <strong>up to 80%</strong> of CO2 emissions with every return.
  </p>

  <figcaption class="text-sm nudge__legend">
    {legend.map((entry, i) => (
      <span class="nudge__legend-item">
        <span class="nudge__badge" aria-hidden="true">{i + 1}</span>
        <span class="nudge__legend-text">
          <strong class="nudge__legend-lever">{entry.lever}</strong> {entry.text}
        </span>
      </span>
    ))}
  </figcaption>
</figure>

<style>
  .shipping__group {
    border: 1px solid var(--border-grey);
    border-radius: 12px;
    background-color: var(--white);
    overflow: hidden;
  }

  .shipping__option {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: start;
    padding: 16px;
  }

  .shipping__option + .shipping__option {
    border-top: 1px solid var(--border-grey);
  }

  .shipping__option--nudged {
    background-color: var(--surface-grey);
  }

  .shipping__radio {
    position: relative;
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    border: 1px solid var(--border-interactive);
    border-radius: 50%;
  }

  .shipping__radio--on {
    border-color: var(--black);
  }

  .shipping__radio--on::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background-color: var(--black);
  }

  .shipping__radio-badge {
    position: absolute;
    top: -8px;
    left: -10px;
  }

  .shipping__labels {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .shipping__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .shipping__info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--dark-grey);
    color: var(--white);
    font-size: 0.625rem;
    font-style: italic;
    line-height: 1;
  }

  .shipping__desc,
  .shipping__price {
    color: var(--dark-grey);
  }

  .shipping__price {
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .shipping__social {
    position: relative;
    display: block;
    margin-top: 4px;
    padding-left: 22px;
    color: var(--accent);
  }

  .shipping__leaf {
    position: absolute;
    left: 0;
    top: 3px;
  }

  .shipping__social-badge {
    position: absolute;
    left: -14px;
    top: 22px;
  }

  /* Inline rather than absolute: the price sits flush against the right edge
     of the option row, so an overhanging badge would land on top of it. */
  .shipping__price--marked {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Shown open. A hover state is unreachable in a static illustration, so the
     tooltip is presented as what it says rather than as an interaction. */
  .shipping__tooltip {
    position: relative;
    padding: 16px;
    border: 1px solid var(--border-grey);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
    background-color: var(--white);
    color: var(--black);
    box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.12), 0px 2px 16px 0px rgba(0, 0, 0, 0.08);
  }

  .shipping__tooltip-badge {
    position: absolute;
    top: -9px;
    left: -9px;
  }

  :global([data-theme='dark']) .shipping__tooltip {
    box-shadow: none;
  }

  @media (max-width: 767px) {
    .shipping__option {
      grid-template-columns: auto 1fr;
      padding: 12px;
    }

    .shipping__price {
      grid-column: 2;
    }

    .shipping__social-badge {
      left: -10px;
    }
  }
</style>
