---
interface Props {
  icon: string
  title: string
  text: string
}

const { icon, title, text } = Astro.props
---
<div class="approach-card">
  <div class="approach-card__icon" set:html={icon}></div>
  <h3 class="approach-card__title">{title}</h3>
  <p class="approach-card__text text-md">{text}</p>
</div>

<style>
  /* Preserve the previous h4 visual size now that this heading is
     semantically an h3 (see global.css: h3 = 1.25rem, h4 = 1.125rem). */
  .approach-card__title {
    font-size: 1.125rem;
    margin-bottom: 4px;
  }
</style>
