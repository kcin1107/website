---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  image?: ImageMetadata
  alt: string
  title: string
  subtitle: string
  topicTag?: string
  tags: string[]
  href?: string
}

const { image, alt, title, subtitle, topicTag, tags, href } = Astro.props
const Tag = href ? 'a' : 'div'
const isSquareImage = image?.width === image?.height
---
<Tag class="project-card" href={href}>
  <div class="project-card__image-wrapper">
    {image && (
      <Image
        class:list={['project-card__image', 'elevation-lg', { 'project-card__image--app-icon': isSquareImage }]}
        src={image}
        alt={alt}
        width={isSquareImage ? 96 : 400}
        height={isSquareImage ? 96 : 225}
        densities={[1, 2]}
      />
    )}
  </div>
  <div class="project-card__content">
    <div class="project-card__titles">
      <h3 class="project-card__title">{title}</h3>
      <span class="project-card__subtitle">{subtitle}</span>
    </div>
    <div class="project-card__tags">
      {topicTag && <span class="tag tag--topic">{topicTag}</span>}
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
</Tag>
