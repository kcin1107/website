---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  image?: ImageMetadata
  imageBorder?: boolean
  alt: string
  title: string
  subtitle: string
  topicTag?: string
  tags: string[]
  href?: string
}

const { image, imageBorder = true, alt, title, subtitle, topicTag, tags, href } = Astro.props
const Tag = href ? 'a' : 'div'
const isSquareImage = image?.width === image?.height

const maxTags = 2
const visibleTags = tags.slice(0, topicTag ? maxTags - 1 : maxTags)
---
<Tag class="project-card" href={href}>
  {image ? (
    <Image
      class:list={['project-card__image', {
        'project-card__image--app-icon': isSquareImage,
        'project-card__image--borderless': !imageBorder,
      }]}
      src={image}
      alt={alt}
      width={isSquareImage ? 96 : 170}
      height={96}
      densities={[1, 2]}
    />
  ) : (
    <div class="project-card__image project-card__image--placeholder" aria-hidden="true"></div>
  )}
  <div class="project-card__content">
    <div class="project-card__titles">
      <h3 class="project-card__title">{title}</h3>
      <span class="project-card__subtitle">{subtitle}</span>
    </div>
    <div class="project-card__tags">
      {topicTag && <span class="tag tag--topic">{topicTag}</span>}
      {visibleTags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
</Tag>
