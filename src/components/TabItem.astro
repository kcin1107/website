---
interface Props {
  label: string
  selected?: boolean
  disabled?: boolean
  href?: string
  [key: string]: unknown
}

const { label, selected = false, disabled = false, href, ...rest } = Astro.props
---

{href ? (
  <a
    class:list={['tab-item', 'text-sm', { 'tab-item--selected': selected, 'tab-item--disabled': disabled }]}
    href={disabled ? undefined : href}
    role="tab"
    aria-selected={selected}
    aria-disabled={disabled || undefined}
    {...rest}
  >{label}</a>
) : (
  <button
    class:list={['tab-item', 'text-sm', { 'tab-item--selected': selected }]}
    role="tab"
    aria-selected={selected}
    disabled={disabled}
    {...rest}
  >{label}</button>
)}

<style>
  .tab-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 8px 12px;
    border-radius: 0;
    color: var(--dark-grey);
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    background: none;
    white-space: nowrap;
    transition: background-color 0.2s ease-out, color 0.2s ease-out;
    flex-shrink: 0;
  }

  .tab-item:hover:not(:disabled):not(.tab-item--disabled) {
    color: var(--black);
  }

  .tab-item--selected,
  .tab-item[aria-selected="true"] {
    background-color: transparent;
    border-color: var(--black);
    color: var(--black);
  }

  .tab-item:disabled,
  .tab-item--disabled {
    color: #B3A67F;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Dark mode: base colours already use theme-adapting vars, so only the
     disabled-state literal (not worth promoting to a token) needs a
     separate dark value. */
  :global([data-theme='dark']) .tab-item:disabled,
  :global([data-theme='dark']) .tab-item--disabled {
    color: #C9798B;
  }
</style>
