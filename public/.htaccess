# Force HTTPS with a 301, so every page has exactly one canonical URL.
#
# IONOS terminates TLS in front of Apache, which makes %{HTTPS} unreliable on
# their webspace. Their own documentation tests the port instead, so that is
# what this uses.
RewriteEngine On

RewriteCond %{SERVER_PORT} !=443
RewriteRule ^(.*)$ https://nickringelmann.com/$1 [R=301,L]

# Only fires if the www subdomain ever points at this webspace. Today it is a
# domain forwarding configured in the IONOS panel, so it never reaches Apache
# and has to be fixed there instead.
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://nickringelmann.com/$1 [R=301,L]

# Compression. IONOS gzips text/html by default but nothing else, so CSS and JS
# went out uncompressed (20.9 KB of CSS instead of 4.7 KB). woff2 and the
# raster/webp images are already compressed — running deflate over them costs
# CPU and gains nothing, so they are deliberately not listed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caching.
#
# Only /_astro/ may be immutable: Astro puts a content hash in those filenames,
# so a changed file always gets a new URL. The files under /assets/ keep stable
# names (Boomerang.svg, Roboto-Variable.woff2), so immutable would pin a
# replaced logo in caches for a year — they get a revalidatable month instead.
# The path test runs through mod_rewrite rather than <If>, which needs Apache
# 2.4 and would 500 the whole site on an older server.
RewriteRule ^_astro/ - [E=CACHE_IMMUTABLE:1]
RewriteRule ^assets/ - [E=CACHE_LONG:1]

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_IMMUTABLE
  Header set Cache-Control "public, max-age=2592000" env=CACHE_LONG

  # HTML stays uncached, otherwise a deploy is invisible to returning visitors.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
